{
  "name": "@gitmoji/landingpage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5310 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5311 --strictPort",
    "types": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "storybook": "pnpm build && storybook dev --host 127.0.0.1 --port 6310 --exact-port --no-open",
    "storybook:build": "pnpm build && storybook build --output-dir storybook-static",
    "check": "pnpm run types && pnpm run format:check && pnpm run build"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
